@startuml Deployment Diagram

!theme plain
skinparam backgroundColor #FEFEFE
skinparam shadowing false

title Store Management System - Deployment Architecture

cloud "Client" as client {
    node "Web Browser" as browser {
        component "React PWA" as react
        component "Service Worker" as sw
        component "IndexedDB" as idb
    }
    
    node "Mobile Device" as mobile {
        component "Progressive Web App" as pwa
    }
}

cloud "CDN" as cdn {
    component "Cloudflare\n(Static Assets)" as cloudflare
}

node "API Server" as server {
    component "Nginx\n(Reverse Proxy)" as nginx
    
    node "Go Application" as go_app {
        component "Gin Router" as gin
        component "JWT Auth" as jwt
        component "Rate Limiter" as ratelimit
        component "API Handlers" as handlers
        component "Business Logic" as logic
        component "Cron Jobs" as cron
    }
}

database "Primary Database" as primary_db {
    component "PostgreSQL\n(Supabase)" as postgres
}

database "Cache Layer" as cache_db {
    component "Redis\n(Upstash)" as redis
}

cloud "External Services" as external {
    component "Twilio\n(SMS)" as twilio
    component "SMTP Server\n(Email)" as smtp
    component "Google Maps API" as gmaps
    component "Google Custom Search" as gcse
}

' ========================================
' Connections
' ========================================
browser --> cdn : static assets
mobile --> cdn : static assets

cdn --> nginx : API requests

nginx --> gin : proxy pass
gin --> jwt : authenticate
gin --> ratelimit : rate limit
gin --> handlers : route to handler
handlers --> logic : execute business logic
logic --> postgres : query/mutate
logic --> redis : cache/read
logic --> twilio : send SMS
logic --> smtp : send email
logic --> gmaps : geocoding
logic --> gcse : search

react --> sw : register
sw --> idb : offline storage
sw --> cloudflare : sync when online

' ========================================
' Deployment Environments
' ========================================
note right of server
  **Production:**
  - Docker container
  - Environment variables
  - SSL/TLS enabled
  - Health checks
  - Graceful shutdown
end note

note bottom of primary_db
  **Supabase:**
  - Managed PostgreSQL
  - Automatic backups
  - Connection pooling
  - Row-level security
end note

note bottom of cache_db
  **Upstash:**
  - Serverless Redis
  - Pay-per-request
  - Global replication
  - Automatic failover
end note

@enduml
